# Database — Postgres required (Neon free tier works for local + Vercel)
# Create at https://console.neon.tech → copy the pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Iron-session cookie encryption (min 32 characters)
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# xAI Grok — server-side only, never expose to the browser
XAI_API_KEY="xai-..."

# Optional: Google Calendar OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# Optional: Strava OAuth (auto-import runs)
# Create an app: https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (or your production domain)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"
# Webhooks need a public HTTPS URL; set the same token when creating the subscription
STRAVA_WEBHOOK_VERIFY_TOKEN="steen_strava_webhook"

# Used for OAuth redirect construction + password reset links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: email for password recovery (https://resend.com)
# Without these, reset links are only printed in server logs (dev fallback)
RESEND_API_KEY=""
EMAIL_FROM="Steen Run Club <onboarding@resend.dev>"
